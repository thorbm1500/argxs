{
    "name": "argxs",
    "version": "0.9.2",
    "scripts": {
        "dev": "vp dev",
        "build": "vp build",
        "preview": "vp preview",
        "lint": "vp lint",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json; vp check --no-fmt",
        "format": "vp fmt"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        }
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.5",
        "@types/bun": "^1.4.4",
        "@types/node": "^25.9.9",
        "globals": "^17.14.0",
        "publint": "^0.3.25",
        "svelte-adapter-bun": "^1.0.2",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
    },
    "keywords": [
        "svelte"
    ],
    "dependencies": {
        "@highlightjs/cdn-assets": "^11.12.0",
        "@humanspeak/svelte-markdown": "^1.9.5",
        "@sveltejs/kit": "^2.70.4",
        "@types/chroma-js": "^3.1.3",
        "chroma-js": "^3.3.0",
        "colord": "^2.12.0",
        "highlight.js": "^11.12.0",
        "moment": "^2.31.0",
        "svelte": "^5.57.3",
        "vite-plus": "0.2.7"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14",
            "onFail": "download"
        }
    }
}