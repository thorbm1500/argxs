{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:argxs:brand-schema",
  "title": "Brand Configuration Schema",
  "type": "object",
  "properties": {
    "name": { "$ref": "#/$defs/name" },
    "href": { "$ref": "#/$defs/href" },
    "tags": { "$ref": "#/$defs/tags" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "href": { "$ref": "#/$defs/href" },
          "type": {
            "type": "string",
            "description": "The asset type",
            "enum": ["icon","logo"]
          },
          "tags": { "$ref": "#/$defs/tags" },
          "default": { "$ref": "#/$defs/icon" },
          "dark": { "$ref": "#/$defs/icon" },
          "variable": {
            "type": "array",
            "items": { "$ref": "#/$defs/icon" }
          }
        },
        "required": ["type","default"],
        "minItems": 1
      }
    },
    "colors": {
      "type": "object",
      "properties": {
        "primary": { "$ref": "#/$defs/colors" },
        "accent": { "$ref": "#/$defs/colors" },
        "colors": { "$ref": "#/$defs/colors" }
      }
    }
  },
  "required": ["name","assets"],
  "$defs": {
    "name": {
      "type": "string",
      "description": "Name of the brand"
    },
    "href": {
      "type": "string",
      "description": "An external link to the brand"
    },
    "tags": {
      "type": "array",
      "description": "Tags related to the icon",
      "items": {
        "type": "string",
        "enum": [
          "Gaming",
          "E-Sports",
          "Live Streaming",
          "Social Media",
          "Entertainment",
          "Development",
          "Tech",
          "Automotive",
          "Music",
          "Food & Drink",
          "AI",
          "Education",
          "Finance",
          "Real Estate",
          "E-Commerce",
          "Shopping",
          "Enterprise",
          "Utility",
          "News & Media"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "date": {
      "type": "string",
      "pattern": "^2[0-9]{3}((/[0-9]{1,2}/[0-9]{1,2})|(-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}\\+[0-9]{2}:[0-9]{2}))$"
    },
    "icon": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/name",
          "description": "Name of the icon"
        },
        "href": {
          "$ref": "#/$defs/href",
          "description": "An external link related to the icon"
        },
        "theme": {
          "type": "string",
          "description": "The theme of the icon. Only to be set if the icon is of such dark/light colors, that it can only properly be seen in a specific theme",
          "enum": ["light","dark"]
        },
        "animated": {
          "type": "boolean",
          "description": "Whether the icon is animated or not",
          "default": false
        },
        "path": {
          "type": "string",
          "description": "The path to the icon",
          "pattern": "^[\\w\\-_]+\\.svg$"
        },
        "date_added": {
          "$ref": "#/$defs/date",
          "description": "The date of which the icon was added"
        },
        "last_modified": {
          "$ref": "#/$defs/date",
          "description": "The date of which the icon was last modified"
        },
        "version": {
          "type": "string",
          "description": "The version of which the icon was added",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "source": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/name",
              "description": "Name of the source"
            },
            "href": {
              "$ref": "#/$defs/href",
              "description": "An external link to the source"
            }
          },
          "required": ["name","href"]
        }
      },
      "required": ["path","date_added","version"]
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hex": {
            "type": "string",
            "pattern": "^#[0-9a-zA-Z]{3,6}$"
          },
          "rgb": {
            "type": "string",
            "pattern": "^[0-9]{1,3} [0-9]{1,3} [0-9]{1,3}$"
          },
          "cmyk": {
            "type": "string",
            "pattern": "^[0-9]{1,3} [0-9]{1,3} [0-9]{1,3} [0-9]{1,3}$"
          },
          "pantone": { "type": "string" }
        },
        "required": ["hex","rgb"]
      }
    }
  }
}