{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:argxs:brand-schema",
  "title": "Brand Configuration Schema",
  "type": "object",
  "properties": {
    "name": { "$ref": "#/$defs/name" },
    "href": { "$ref": "#/$defs/href" },
    "tags": { "$ref": "#/$defs/tags" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "$ref": "#/$defs/name" },
          "href": { "$ref": "#/$defs/href" },
          "type": { "$ref": "#/$defs/type" },
          "tags": { "$ref": "#/$defs/tags" },
          "default": { "$ref": "#/$defs/icon" },
          "dark": { "$ref": "#/$defs/icon" },
          "variable": {
            "type": "array",
            "items": { "$ref": "#/$defs/icon" }
          }
        },
        "required": ["type","default"]
      }
    }
  },
  "required": ["name","assets"],
  "$defs": {
    "name": {
      "type": "string",
      "description": "Name of the brand"
    },
    "href": {
      "type": "string",
      "description": "An external link to the brand"
    },
    "type": {
      "type": "string",
      "enum": ["icon","logo"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Gaming","E-Sports","Social Media","Development","Automotive","Music"]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "date": {
      "type": "string",
      "pattern": "^2[0-9]{3}/[0-9]{1,2}/[0-9]{1,2}$"
    },
    "icon": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/name",
          "description": "Name of the icon"
        },
        "href": {
          "$ref": "#/$defs/href",
          "description": "An external link related to the icon"
        },
        "theme": {
          "type": "string",
          "enum": ["light","dark"]
        },
        "animated": {
          "type": "boolean",
          "default": false
        },
        "path": {
          "type": "string",
          "pattern": "^[\\w\\-_]+\\.svg$"
        },
        "date_added": { "$ref": "#/$defs/date" },
        "last_modified": { "$ref": "#/$defs/date" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "source": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/name",
              "description": "Name of the source"
            },
            "href": {
              "$ref": "#/$defs/href",
              "description": "An external link to the source"
            }
          },
          "required": ["name","href"]
        }
      },
      "required": ["path","date_added","version"]
    }
  }
}